{{- $acquia := promptBoolOnce . "acquia" "Is this an Acquia work machine" false -}}
{{- $gh_username := promptStringOnce . "gh_username" "GitHub Username (used for git commit signature validation)" "dbeg" -}}
{{- $email := promptStringOnce . "email" "Email address (used for git)" "dbeg@users.noreply.github.com" -}}
{{- $name := promptStringOnce . "name" "Full name (used for git)" "Dan Beghin" -}}

{{- $gh_signing_key := "id_ed25519_github_dbeg_work" -}}
{{- $bw_url := "" -}}
{{ if not $acquia -}}
  {{- $gh_signing_key = "github-dbeg-2026.07" -}}
  
  # Personal Bitwarden URL (since I'm self-hosting a Vaultwarden instance)
  {{- $bw_url = promptStringOnce . "bw_url" "Bitwarden URL (example: https://bw.lab.home.arpa)" -}}
{{- end }}

{{- $wsl := false -}}
{{- if eq .chezmoi.os "linux" -}}
  {{- $kernel := output "uname" "-r" | lower -}}
  {{- if contains "microsoft" $kernel -}}
    {{- $wsl = true -}}
  {{- end -}}
{{- end }}

[data]
  acquia         = {{ $acquia }}
  gh_username    = {{ $gh_username | quote }}
  gh_signing_key = {{ $gh_signing_key | quote }}
  email          = {{ $email | quote }}
  name           = {{ $name | quote }}
  bw_url         = {{ $bw_url | quote }}
  wsl            = {{ $wsl }}

[diff]
  command = "code"
  args = [
    "--wait",
    "--diff",
    "{{ `{{ .Destination }}` }}",
    "{{ `{{ .Target }}` }}"
  ]

[merge]
  command = "bash"
  args = [
      "-c",
      """
      cp {{ `{{ .Target | quote }}` }} {{ `{{ printf \"%s.base\" .Target | quote }}` }} && \
      code --new-window --wait --merge \
      {{ `{{ .Destination | quote }}` }} \
      {{ `{{ .Target | quote }}` }} \
      {{ `{{ printf \"%s.base\" .Target | quote }}` }} \
      {{ `{{ .Source | quote }}` }} \
      """
  ]
