{
    "$schema": "https://opencode.ai/config.json",
    "model": "opencode/big-pickle",
    "small_model": "opencode/kimi-k2.5-free",
    "plugin": [
        "superpowers@git+https://github.com/obra/superpowers.git"
    ],
    "default_agent": "plan",
    "agent": {
        "plan": { "color": "success" },
        "build": { "color": "error" }
    },
    "autoupdate": false,
    "snapshot": false,
    "lsp": true,
    "watcher": {
        "ignore": [
            "node_modules/**",
            "dist/**",
            ".git/**"
        ]
    },
    "permission": {
        "external_directory": {
            // Scoped temp/caching workspace for agents. AGENTS.md (Tooling)
            // points agents here so temp work stays in a permissioned dir
            // instead of the working/home dir or unpermissioned $TMPDIR.
            "/private/tmp/opencode/**": "allow",
            "/tmp/opencode/**": "allow",
        }
    }
}
