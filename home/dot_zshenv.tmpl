typeset -U path manpath

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_BIN_HOME="$HOME/.local/bin"

# ~/.zshenv is the only zsh file that must live in $HOME, everything else is read from here.
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
# Stop macOS's /etc/zshrc_Apple_Terminal from creating ~/.zsh_sessions
export SHELL_SESSIONS_DISABLE=1

export DOT_SRC_HOME="$HOME/src"
export DOT_SRC_CODEBERG="$DOT_SRC_HOME/codeberg.org"
export DOT_SRC_GITHUB="$DOT_SRC_HOME/github.com"
export DOT_SRC_GITLAB="$DOT_SRC_HOME/gitlab.com"
export DOT_SRC_DBEG="$DOT_SRC_GITHUB/dbeg"
export DOT_SRC_LOCAL="$DOT_SRC_HOME/local"

if command -v code >/dev/null 2>&1; then
  export EDITOR="code --wait"
fi

{{ if .wsl -}}
# Bitwarden SSH Agent Bridge for WSL2
export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"

socket_ok=0
if [ -S "$SSH_AUTH_SOCK" ]; then
    if command -v ss >/dev/null 2>&1; then
        ss -lx 2>/dev/null | grep -qF "$SSH_AUTH_SOCK" && socket_ok=1
    else
        socket_ok=1
    fi
fi
if [ "$socket_ok" -eq 0 ]; then
    rm -f "$SSH_AUTH_SOCK"

    # Cache location for the resolved binary path
    NPIPERELAY_CACHE="$XDG_CACHE_HOME/npiperelay_path"

    # 1. Read cached path, or locate via Windows PATH/WinGet glob fallback
    if [ -f "$NPIPERELAY_CACHE" ] && [ -x "$(cat "$NPIPERELAY_CACHE")" ]; then
        NPIPERELAY_PATH=$(cat "$NPIPERELAY_CACHE")
    else
        mkdir -p "$XDG_CACHE_HOME"
        WIN_PATH=$(where.exe npiperelay.exe 2>/dev/null | head -n 1 | tr -d '\r')

        if [ -n "$WIN_PATH" ]; then
            NPIPERELAY_PATH=$(wslpath -u "$WIN_PATH")
        else
            # Wildcard fallback to handle WinGet directory structure dynamically
            NPIPERELAY_PATH=$(ls /mnt/c/Users/*/AppData/Local/Microsoft/WinGet/Packages/albertony.npiperelay*/npiperelay.exe 2>/dev/null | head -n 1)
        fi

        # Save to cache if found
        if [ -n "$NPIPERELAY_PATH" ]; then
            echo "$NPIPERELAY_PATH" > "$NPIPERELAY_CACHE"
        fi
    fi

    # 2. Spawn the background bridge
    if [ -n "$NPIPERELAY_PATH" ]; then
        ( setsid socat UNIX-LISTEN:"$SSH_AUTH_SOCK",fork EXEC:"${NPIPERELAY_PATH} -p -l -ei -s //./pipe/openssh-ssh-agent",nofork & ) >/dev/null 2>&1
    fi
fi
{{- end }}

export YARN_ENABLE_SCRIPTS=false
export NPM_CONFIG_IGNORE_SCRIPTS=true
export NPM_CONFIG_CACHE="$XDG_CACHE_HOME/npm"
export NPM_CONFIG_LOGS_DIR="$XDG_STATE_HOME/npm/logs"

export TUF_ROOT="$XDG_CACHE_HOME/sigstore"
export GNUPGHOME="$XDG_DATA_HOME/gnupg"

export BITWARDENCLI_APPDATA_DIR="$XDG_CONFIG_HOME/bw"
export TEALDEER_CONFIG_DIR="$XDG_CONFIG_HOME/tealdeer"

export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ENV_HINTS=1

export GOMODCACHE="$XDG_CACHE_HOME/go/mod"
export GOPATH="$XDG_STATE_HOME/go"

export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship/starship.toml"

source "$ZDOTDIR/includes/path.zsh"

# Work config (sets env vars, sources secrets.env)
[[ -f "$HOME/.work/env.sh" ]] && source "$HOME/.work/env.sh"

export PATH MANPATH
